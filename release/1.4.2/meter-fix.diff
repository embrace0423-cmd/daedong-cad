+
+const meterSquare = fs.readFileSync(path.join(fixtures,'square-one-inch.dxf'),'utf8')
+  .replace(/(\$INSUNITS\r?\n70\r?\n)1(?=\r?\n)/, '$16');
+const desktop = fs.readFileSync(path.join(__dirname,'../src/main.js'),'utf8');
+
+function meterImport(response) {
+ const c=runtime();
+ const reports=[], messages=[];
+ const initial={name:'previous'};
+ const dialogStart=desktop.indexOf("ipcMain.handle('dcad:choose-units'");
+ const dialogEnd=desktop.indexOf("ipcMain.handle('dcad:choose-recovery'",dialogStart);
+ const openStart=html.indexOf('  function openData(name, bytes, path, token) {');
+ const openEnd=html.indexOf('  function openRecoveryArchive()',openStart);
+ assert.ok(dialogStart>=0&&dialogEnd>dialogStart&&openStart>=0&&openEnd>openStart);
+ Object.assign(c,{
+  ipcMain:{handle:(channel, handler)=>{assert.equal(channel,'dcad:choose-units');c.chooseUnits=handler;}},
+  dialog:{showMessageBox:async(_win,opts)=>{reports.push(opts);return {response};}},
+  win:{}, App:{doc:initial,sessionId:1,revision:0,dirty:false},
+  NS:{...c.DCAD,Safety},Model:c.DCAD.Model,G:c.DCAD.G,
+  Desk:{chooseUnits:code=>c.chooseUnits(null,code)},
+  replaceDoc:d=>{c.App.doc=d;},updateTitle:()=>{},msg:m=>messages.push(m),
+ });
+ vm.runInContext(desktop.slice(dialogStart,dialogEnd),c);
+ vm.runInContext(html.slice(openStart,openEnd),c);
+ return {c,initial,reports,messages};
+}
+
+test('meter-tagged DXF opens with unchanged mm coordinates or 1000× meter conversion',async()=>{
+ for(const [response,mm] of [[0,1],[1,1000]]){
+  const {c,reports,messages}=meterImport(response);
+  assert.equal(c.DCAD.DXF.read(Buffer.from(meterSquare)).report.insunits,6);
+  assert.equal(await c.openData('meter.dxf',Buffer.from(meterSquare),'meter.dxf'),true);
+  assert.equal(reports.length,1);
+  assert.equal(reports[0].defaultId,reports[0].cancelId);
+  assert.equal(c.App.doc.ents.length,4);
+  for(const line of c.App.doc.ents){
+   near(Math.hypot(line.b.x-line.a.x,line.b.y-line.a.y),mm);
+  }
+  assert.ok(messages.some(m=>m.includes(response===0?'변환하지 않고':'1,000배')));
+ }
+});
+
+test('cancelling the meter import keeps the current drawing',async()=>{
+ const {c,initial,reports}=meterImport(2);
+ assert.equal(await c.openData('meter.dxf',Buffer.from(meterSquare),'meter.dxf'),false);
+ assert.equal(reports.length,1);
+ assert.equal(c.App.doc,initial);
+ assert.equal(c.App.dirty,false);
+});
